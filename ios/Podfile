# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# --- Guard: Xcode 16.x sets objectVersion=70 which older xcodeproj/CocoaPods can't parse.
# This makes `pod install` self-healing even if Xcode rewrites the project file.
def ensure_compatible_xcodeproj_object_version!
  pbxproj_path = File.expand_path(File.join(__dir__, 'Runner.xcodeproj', 'project.pbxproj'))
  return unless File.exist?(pbxproj_path)

  contents = File.read(pbxproj_path)
  if contents.include?('objectVersion = 70;')
    puts('[Podfile] Detected objectVersion=70 in Runner.xcodeproj; patching to 54 for CocoaPods compatibility...')
    contents = contents.gsub('objectVersion = 70;', 'objectVersion = 54;')
    File.write(pbxproj_path, contents)
  end
end

ensure_compatible_xcodeproj_object_version!

# --- Patch: xcodeproj 1.27.0 crashes on Xcode 26.x because groupable_helper calls
# source_tree/path on XCBuildConfiguration, which doesn't have those methods.
# We patch GroupableHelper directly so gem updates don't reset the fix.
require 'xcodeproj'
module Xcodeproj
  class Project
    module Object
      class GroupableHelper
        class << self
          def real_path(object)
            return object.project.project_dir unless object.respond_to?(:path)
            source_tree = source_tree_real_path(object)
            path = object.path || ''.freeze
            source_tree ? source_tree + path : Pathname(path)
          end

          def source_tree_real_path(object)
            return object.project.project_dir unless object.respond_to?(:source_tree)
            case object.source_tree
            when '<group>'
              object_parent = parent(object)
              if object_parent.isa == 'PBXProject'.freeze
                object.project.project_dir + object.project.root_object.project_dir_path
              else
                real_path(object_parent)
              end
            when 'SOURCE_ROOT'
              object.project.project_dir
            when '<absolute>'
              nil
            else
              Pathname.new("${#{object.source_tree}}")
            end
          end
        end
      end
    end
  end
end

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
